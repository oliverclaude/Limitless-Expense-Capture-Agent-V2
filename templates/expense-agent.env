# Expense agent version 2.
# Install on limitlessfin as /etc/expense-agent-v2/env (mode 600, owner ${HERMES_USER}).
# Leave the secret lines empty in git. Fill them only on the container.
# Version 1 keeps /etc/expense-agent/env and still accepts only the subject prefix claim:.
# Load this file with ENV_FILE=/etc/expense-agent-v2/env.

# Matched at the start of the subject. Case is ignored.
# claimv2: does not match version 1.
CLAIM_SUBJECT_PREFIX=claimv2:

IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# Comma-separated addresses allowed to send a claim
# (From, Sender, Reply-To, Return-Path, Resent-From). Empty = refuse all claims.
CLAIM_FROM=
# Must appear somewhere in the email body. Empty = refuse all claims.
CLAIM_PASSWORD=

CLAIM_FOLDER_PROCESSED=processed
CLAIM_FOLDER_REVIEW=needs_review
CLAIM_FOLDER_FAILED=failed
CLAIM_REJECT_FOLDER=rejected

# Done and Skipped mail goes here only. Never take it from the claim headers.
WORK_EMAIL=
# SMTP defaults to the IMAP host, user, and password. Port 465 if empty.
SMTP_HOST=
SMTP_PORT=

# Same ledger as version 1. Proofs and the month sheet live under this mount.
EXPENSES_ROOT=/g-drive
# Not version 1's /g-drive/agent-state. The two queues must not share a file.
AGENT_STATE_DIR=/g-drive/agent-state-v2

# Local vision model. Set these on the machine. Do not commit the server address.
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_API_KEY=
# Seconds to wait for one vision call. The local model is slow.
# The Hermes job limit must be at least this long, or the job is killed first.
OLLAMA_TIMEOUT_SECONDS=7200

# Comma-separated journals the model may pick from.
JOURNALS=Entertainment,Staff Welfare,Telephone & Internet,Energy,Computer Equipment,Courier & Postage,Office Equipment,Marketing
# Extra words that force Staff Welfare, on top of the built-in kitchen, grocery, and cleaning words.
STAFF_WELFARE_HINTS=
# Journals that may include VAT. Every other journal is forced to 0.
VAT_JOURNALS=Telephone & Internet,Energy,Computer Equipment,Office Equipment

# Slip pictures and chat. Set the server address on the machine. Do not commit it.
# Do not use version 1's topic Fin-Limitless.
NTFY_URL=
NTFY_TOPIC=Fin-Limitless-V2

# Delete logged or skipped state after the Done or Skipped mail is sent. 1 = yes, 0 = keep until retention.
DELETE_COMPLETED_STATE=1
# Delete any state file this many days after its last update.
STATE_RETENTION_DAYS=60

# Checkout of this repo on the machine. Do not commit the home path.
AGENT_HOME=
# How often the mail job runs. The gateway's 60 second wake-up only checks whether this job is due.
POLL_INTERVAL_MINUTES=30
# Hold the claim and ask when personal plus company is strictly greater than this many rand.
HIGH_VALUE_ZAR=500
