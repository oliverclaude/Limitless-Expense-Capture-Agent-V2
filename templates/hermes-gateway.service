# Shape of the system unit Hermes writes. Do not copy this in by hand.
# Install it with the command in INSTALL.md. Hand-copying skips linger,
# daemon-reload, and the launcher setup.
#
# Placeholders, filled for the account that owns the Hermes home:
#   ${HERMES_USER}   account name
#   ${HERMES_GROUP}  account group
#   ${HERMES_UID}    numeric uid
#   ${ACCOUNT_HOME}  that account's home directory
#   ${HERMES_HOME}   Hermes data directory, usually ${ACCOUNT_HOME}/.hermes
[Unit]
Description=Hermes Agent Gateway - Messaging Platform Integration
After=network-online.target
Wants=network-online.target
After=user@${HERMES_UID}.service
Wants=user@${HERMES_UID}.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=${HERMES_USER}
Group=${HERMES_GROUP}
ExecStart="${HERMES_HOME}/hermes-agent/.hermes/bin/hermes" "gateway" "run"
WorkingDirectory=${HERMES_HOME}
Environment="HOME=${ACCOUNT_HOME}"
Environment="USER=${HERMES_USER}"
Environment="LOGNAME=${HERMES_USER}"
Environment="PATH=${HERMES_HOME}/tools/node-26.12.1-linux-x64/bin:${HERMES_HOME}/tools/npm-12.0.2-linux-x64/bin:${HERMES_HOME}/hermes-agent/node_modules/.bin:${ACCOUNT_HOME}/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

Environment="HERMES_HOME=${HERMES_HOME}"
Environment="HERMES_SUPERVISED_CHILD=1"
Restart=always
RestartSec=5
RestartForceExitStatus=75
SuccessExitStatus=75
RestartPreventExitStatus=78
KillMode=mixed
KillSignal=SIGTERM
ExecReload=/bin/kill -USR1 $MAINPID
ExecStop=-"${HERMES_HOME}/hermes-agent/.hermes/bin/hermes" "--run-module" "gateway.systemd_stop_mark"
ExecStopPost=-"${HERMES_HOME}/hermes-agent/.hermes/bin/hermes" "--run-module" "gateway.cgroup_cleanup"
TimeoutStopSec=70
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
