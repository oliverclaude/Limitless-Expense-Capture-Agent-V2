# Append these lines to ~/.hermes/.env on the machine that runs Hermes.
# Set NTFY_SERVER_URL on that machine. Do not commit the server address.
# No token: publish without one only if that server allows it.
# Do not set any EMAIL_* variables. The email adapter stays off.
NTFY_SERVER_URL=
NTFY_TOPIC=Fin-Limitless-V2
NTFY_ALLOWED_USERS=Fin-Limitless-V2
NTFY_HOME_CHANNEL=Fin-Limitless-V2
NTFY_HOME_CHANNEL_NAME=Fin-Limitless-V2
NTFY_MARKDOWN=true
